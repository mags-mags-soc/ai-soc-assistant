
# --- AI Engine (Sprint 2) ---
# The AI layer is provider-agnostic: it speaks the OpenAI chat-completions
# protocol, so any OpenAI-compatible endpoint works. Only these variables
# change when switching provider - never the client code.
#
# Anthropic (OpenAI-compatible endpoint):
#   AI_BASE_URL=https://api.anthropic.com/v1/
#   AI_MODEL=claude-haiku-4-5-20251001   # cheapest; claude-sonnet-5 for depth
#
# OpenAI:
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-5.6-luna                 # cheapest tier
#
# Alert triage is a classification task; a small model is usually enough.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT=60
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.2
# OpenAI's json_object response mode. Anthropic's OpenAI-compatible endpoint
# rejects it, so set false there. Output is still validated by AIAnalysis.
AI_JSON_MODE=true

# --- Dashboard (Sprint 4) ---
# "disabled" renders an explicit empty state and never calls a provider.
# Set to "analyzer" once AI_API_KEY above is populated.
DASHBOARD_ANALYSIS_SOURCE=disabled
DASHBOARD_SOURCE=sample
DASHBOARD_ALERT_LIMIT=50

# --- Notifications ---
# Each channel is optional. A channel with missing settings is skipped, not
# an error, so the pipeline still runs with analysis and reports only.

# Telegram bot (create via @BotFather, then read the chat id from getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP. Gmail needs an app password, not the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_RECIPIENTS=          # comma separated
SMTP_USE_TLS=true

# --- Paths ---
SOC_REPORTS_DIR=          # defaults to ./reports
SOC_STATE_DIR=            # defaults to ./state
